        "authentication": "genericCredentialType",
        "genericAuthType": "httpQueryAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.medya_turu === 'VIDEO' ? { media_type: 'REELS', video_url: $json.medya_url, caption: $json.metin, share_to_feed: true } : { image_url: $json.medya_url, caption: $json.metin }) }}",
        "options": {}
