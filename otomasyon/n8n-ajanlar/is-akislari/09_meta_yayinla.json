{
  "name": "MaviSudoku | 09 Meta Yayınla (Denetçi zorunlu)",
  "nodes": [
    {
      "parameters": {
        "inputSource": "passthrough"
      },
      "id": "426310d1-e6e7-438f-8367-6e3bd3eb79c5",
      "name": "Başlangıç",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.1,
      "position": [
        0,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "const ham = $input.first().json.query;\nlet g;\ntry { g = typeof ham === 'string' ? JSON.parse(ham) : ham; }\ncatch (e) { return [{ json: { hata: 'Girdi JSON değil: {\"medya_turu\",\"medya_url\",\"metin\"} bekleniyor.' } }]; }\nconst tur = (g.medya_turu || 'GORSEL').toUpperCase();\nif (!g.medya_url || !g.metin) return [{ json: { hata: 'medya_url ve metin zorunlu.' } }];\nif (g.metin.length > 2200) return [{ json: { hata: 'Metin 2200 karakteri aşıyor.' } }];\nreturn [{ json: { medya_turu: tur === 'VIDEO' ? 'VIDEO' : 'GORSEL', medya_url: g.medya_url, metin: g.metin } }];"
      },
      "id": "312634bc-db32-42b2-a6a1-1c24344a86c3",
      "name": "Girdi Çöz",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        300
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT (SELECT deger FROM ayarlar WHERE anahtar = 'sistem_aktif') AS aktif, (SELECT count(*) FROM ajan_islem_kaydi WHERE ajan = 'meta_yayin' AND sonuc LIKE 'YAYINLANDI%' AND zaman::date = (now() AT TIME ZONE 'Europe/Istanbul')::date) AS bugun_yayin;",
        "options": {}
      },
      "id": "b5a28996-d99d-4955-ba4c-b6f160cb3849",
      "name": "Sistem ve Sınır Kontrolü",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        460,
        300
      ],
      "credentials": {
        "postgres": {
          "id": "KIMLIK_SEC",
          "name": "MaviSudoku Postgres"
        }
      },
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "jsCode": "const g = $('Girdi Çöz').first().json;\nif (g.hata) return [{ json: { onay: false, sonuc: 'HATA: ' + g.hata } }];\nconst k = $input.first().json;\nif (k.aktif !== 'evet') return [{ json: { onay: false, sonuc: 'DURDURULDU: Sistem acil durdurma modunda.' } }];\nif (Number(k.bugun_yayin) >= 3) return [{ json: { onay: false, sonuc: 'SINIR: Bugün 3 paylaşım sınırına ulaşıldı.' } }];\nreturn [{ json: { query: `İçerik türü: Instagram + Facebook paylaşımı (${g.medya_turu}).\\nHedef kitle: Türkiye'deki tüm yaşlar.\\nMedya URL: ${g.medya_url}\\nPaylaşım metni:\\n${g.metin}` } }];"
      },
      "id": "bede5212-9ec5-4416-a43e-64c3e16a3df9",
      "name": "Denetime Hazırla",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        700,
        300
      ]
    },
    {
      "parameters": {
        "source": "database",
        "workflowId": {
          "__rl": true,
          "mode": "id",
          "value": "BAGLA_08_DENETCI"
        },
        "options": {}
      },
      "id": "0aa6377f-2c06-4492-bc53-bc0ab5867e90",
      "name": "Denetçi",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.1,
      "position": [
        940,
        300
      ],
      "continueOnFail": true
    },
    {
      "parameters": {
        "jsCode": "const onceki = $('Denetime Hazırla').first().json;\nif (onceki.onay === false) return [{ json: onceki }];\nlet d;\ntry { d = JSON.parse($input.first().json.sonuc); } catch (e) { d = { karar: 'RED', gerekce: 'Denetçi cevabı okunamadı.' }; }\nconst g = $('Girdi Çöz').first().json;\nif (d.karar !== 'ONAY') return [{ json: { onay: false, sonuc: `RED: ${d.gerekce} | Düzeltme: ${d.duzeltme || '-'}` } }];\nreturn [{ json: { onay: true, ...g } }];"
      },
      "id": "a473008f-f8e7-4655-9105-7701ca15a0a2",
      "name": "Karar",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1160,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "56c902a2-3ad2-42c0-a727-86aec3a98d35",
              "leftValue": "={{ $json.onay }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "b5bb404f-c8d8-4811-936f-49d220cd2e9f",
      "name": "Onaylandı mı?",
