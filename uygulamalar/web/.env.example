# MaviSudoku ortam değişkenleri: bu dosyayı ".env" adıyla kopyalayıp sunucuda doldurun.
# .env dosyası git'e girmez; şifreleri ve anahtarları asla sohbete ya da depoya yazmayın.

# Sitenin adresi (e-postalardaki bağlantılar ve site haritası bunu kullanır)
SITE_URL=https://mavisudoku.com

# Veritabanı: yayında PostgreSQL bağlantısı. Boş bırakılırsa gömülü PGlite (veri/pglite) kullanılır.
DATABASE_URL=

# E-posta (şifre sıfırlama): seçilen servisin SMTP adresi, ör. smtps://KULLANICI:SIFRE@smtp-relay.brevo.com:465
SMTP_URL=
EPOSTA_GONDEREN=MaviSudoku <bildirim@mavisudoku.com>

# Google AdSense (onay gelince). Değiştirince site yeniden derlenmeli (npm run build).
NEXT_PUBLIC_ADSENSE_ISTEMCI=
NEXT_PUBLIC_ADSENSE_SLOT_ICERIK=
NEXT_PUBLIC_ADSENSE_SLOT_YAN=
